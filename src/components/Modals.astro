    <p>This platform shall not be held responsible for any inconvenience resulting from its use.</p>
  </div>
</div>

<div id="favModal" class="modal" role="dialog" aria-modal="true" aria-labelledby="favModalTitle">
  <div class="modal-box">
    <button class="modal-close" id="favModalClose" aria-label="Close favourites">×</button>
    <h2 id="favModalTitle">⭐ Favourites</h2>
    <div id="favModalContent"></div>
  </div>
</div>
